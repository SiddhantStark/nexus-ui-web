{
  "name": "nexus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "oxfmt --write \"src/**/*.{ts,tsx,css}\" vite.config.ts eslint.config.js package.json tsconfig.json .oxfmtrc.json README.md AGENTS.md",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format:check": "oxfmt --check \"src/**/*.{ts,tsx,css}\" vite.config.ts eslint.config.js package.json tsconfig.json .oxfmtrc.json README.md AGENTS.md"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "oxfmt": "^0.68.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0",
    "pnpm": "10.34.3"
  },
  "packageManager": "pnpm@10.34.3"
}
